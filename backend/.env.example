# Copy to .env and adjust. Validated at startup by src/config/env.ts.
NODE_ENV=development
PORT=4000

# PostgreSQL connection (matches docker-compose.yml).
DATABASE_URL=postgresql://salary:salary@localhost:5432/salary_management?schema=public

# Seeded HR Manager login (local development only; change for any shared environment).
SEED_HR_EMAIL=hr.manager@acme.example
SEED_HR_PASSWORD=ChangeMe-Local-Dev-1
