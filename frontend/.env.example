# Frontend settings (all optional). Copy to .env.local to override.

# Where the Vite dev server proxies /api during `npm run dev` / `npm run preview`.
API_PROXY_TARGET=http://localhost:4000

# Base path of the API as seen by the browser. Keep the default (/api): in production
# Vercel rewrites /api to the backend (vercel.json), so the session cookie stays first-party.
# VITE_API_BASE_URL=/api
